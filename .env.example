# Database (Neon pooled connection string, Npgsql format)
ConnectionStrings__DefaultConnection=Host=YOUR_HOST;Database=neondb;Username=YOUR_USER;Password=YOUR_PASSWORD;Ssl Mode=Require

# JWT
Jwt__Secret=
Jwt__Issuer=PharmacyFinder
Jwt__Audience=PharmacyFinderUsers

# CORS — comma-separated frontend origins (local vs production)
# Local:  http://localhost:4200,http://127.0.0.1:4200
# Deploy: https://your-frontend-domain.com
# Set AllowAll=true for dev; set false and list origins before production lock-down
Cors__AllowAll=true
Cors__AllowedOrigins=http://localhost:4200,http://127.0.0.1:4200

# Storage: Cloudinary or Local
Storage__Provider=Cloudinary
Storage__PrescriptionUploadPath=uploads/prescriptions
Storage__MaxFileSizeMb=10

# Cloudinary (https://cloudinary.com/console)
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=prescriptions

# Tesseract OCR
Tesseract__DataPath=tessdata
Tesseract__Language=eng

# Bootstrap admin (first deploy only — remove after first login)
BootstrapAdmin__Email=
BootstrapAdmin__Password=
BootstrapAdmin__FullName=

ASPNETCORE_ENVIRONMENT=Development
